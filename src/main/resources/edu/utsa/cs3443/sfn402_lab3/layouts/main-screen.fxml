<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.image.Image?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.utsa.cs3443.sfn402_lab3.MainScreenController"
            prefWidth="1000" prefHeight="650"
            style="-fx-background-color: #f0f4f8;">

  <padding>
    <Insets top="20" right="20" bottom="20" left="20"/>
  </padding>

  <top>
    <HBox alignment="CENTER_LEFT" spacing="20">
      <padding>
        <Insets bottom="25"/>
      </padding>
      <!-- Added the logo here in this spot -->
      <ImageView fx:id="logoImageView"
                 fitWidth="80" fitHeight="80"
                 preserveRatio="true">
        <image>
          <Image url="@../images/logo.png"/>
        </image>
      </ImageView>

      <VBox alignment="CENTER_LEFT" spacing="8">
        <Label text="The Global Emergency Response Organization"
               wrapText="true"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #17365d;"/>
        <Label text="Aid Ship Management System"
               style="-fx-font-size: 18px;"/>
      </VBox>
    </HBox>
  </top>

  <left>
    <VBox spacing="18" prefWidth="220">
      <padding>
        <Insets right="20"/>
      </padding>

      <Button text="List Ships"
              onAction="#onListShipsClick"
              maxWidth="Infinity"
              style="-fx-font-size: 16px;"/>

      <Label text="Registration Number"
             style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

      <TextArea fx:id="registrationTextArea"
                promptText="Enter registration number"
                prefRowCount="2"
                wrapText="true"/>

      <RadioButton fx:id="findRadioButton" text="Find"/>
      <RadioButton fx:id="deleteRadioButton" text="Delete"/>

      <Button text="Go!"
              onAction="#onGoClick"
              maxWidth="Infinity"
              style="-fx-font-size: 16px;"/>
    </VBox>
  </left>

  <center>
    <TextArea fx:id="resultsTextArea"
              editable="false"
              wrapText="true"
              promptText="Click List Ships to display aid ships."
              style="-fx-font-family: 'Monospaced'; -fx-font-size: 14px;"/>
  </center>

  <bottom>
    <Label text="© 2026 Brian Caloca"
           BorderPane.alignment="CENTER">
      <padding>
        <Insets top="20"/>
      </padding>
    </Label>
  </bottom>

</BorderPane>